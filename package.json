{
	"name": "obsidian-sample-plugin",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "svelte-check --tsconfig tsconfig.json && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "svelte-check --tsconfig tsconfig.json && eslint .",
		"svelte-check": "svelte-check --tsconfig tsconfig.json"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"postcss": "^8.5.23",
		"postcss-load-config": "^6.0.1",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"svelte2tsx": "^0.7.58",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"typescript-eslint-parser-for-extra-files": "^0.9.0"
	}
}
